[Unit]
Description=Bilibili danmu recorder (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/home/ecs-user/%i
ExecStart=/home/ecs-user/%i/Danmu
Environment=DANMU_INSTANCE=%i
EnvironmentFile=-/home/ecs-user/%i/conf/danmu.env
EnvironmentFile=-/home/ecs-user/.config/danmu/lark.env
Restart=always
RestartSec=10s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ecs-user/%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
